{
	"version": 2,
	"rewrites": [
		{ "source": "/(.*)", "destination": "/" },
		{
			"source": "/api/:path",
			"destination": "https://api.nextleet.com/:path"
		}
	],
	"headers": [
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
